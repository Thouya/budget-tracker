# Copy this file to .env and fill in real values before running docker compose.

# Password required to open the app. Choose something you don't use elsewhere.
APP_PASSWORD=changeme

# Random secret used to sign session cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=changeme-generate-a-real-random-secret

# Port exposed on the host machine.
HOST_PORT=3000

# Uncomment if you're accessing the app over plain HTTP (no TLS/reverse proxy) —
# without this, the login session cookie requires HTTPS and login won't persist.
# DISABLE_SECURE_COOKIE=1
